# Crie a chave em https://openrouter.ai/keys e preencha apenas no .env local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Normalmente: uma chamada gera SQL, outra explica o resultado; terceira permite correção.
CINEDATA_MAX_MODEL_CALLS=3
# Caminhos relativos são resolvidos a partir da raiz do projeto.
CINEDATA_DB_PATH="cinerocket-db/cinerocket (1).db"
